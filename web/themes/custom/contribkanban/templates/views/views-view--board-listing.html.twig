{#
/**
 * @file
 * The board listing: search, popular searches, type links, board cards, and
 * the pager.
 */
#}
<div{{ attributes.addClass('board-listing') }}>
  {{ title_prefix }}
  {{ title_suffix }}
  {% if header %}
    <div class="board-listing__intro">{{ header }}</div>
  {% endif %}
  <div class="board-listing__search">
    {{ exposed }}
    {{ include('contribkanban:popular-searches', {items: popular}, with_context = false) }}
  </div>
  <div class="board-listing__results">
    {{ include('contribkanban:pill-nav', {label: 'Board type'|t, items: type_links, variant: 'solid'}, with_context = false) }}
    {% if rows %}
      <div class="board-listing__grid{{ show_popular ? ' board-listing__grid--popular' }}">{{ rows }}</div>
    {% elseif empty %}
      <div class="board-listing__empty">{{ empty }}</div>
    {% endif %}
  </div>
  {{ pager }}
</div>
