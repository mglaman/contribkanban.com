<?php

/**
 * @file
 * Theme hooks for ContribKanban.
 */

use Drupal\contribkanban_boards\Entity\BoardInterface;
use Drupal\contribkanban_boards\Entity\NodeBoard;
use Drupal\contribkanban_boards\PopularBoards;
use Drupal\Core\Cache\Cache;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Url;

/**
 * Implements hook_preprocess_HOOK() for page templates.
 */
function contribkanban_preprocess_page(array &$variables): void {
  $route_name = \Drupal::routeMatch()->getRouteName();
  $variables['site_name'] = (string) \Drupal::config('system.site')->get('name');
  $variables['front_url'] = Url::fromRoute('<front>')->toString();
  $variables['main_nav'] = [
    [
      'label' => (string) t('Boards'),
      'description' => (string) t('Projects, tags and issue collections'),
      'icon' => 'boards',
      'url' => Url::fromRoute('view.board_listing.page')->toString(),
      'current' => $route_name === 'view.board_listing.page',
    ],
    [
      'label' => (string) t('Roulette'),
      'description' => (string) t('Roll for an issue to work on'),
      'icon' => 'roulette',
      'url' => Url::fromRoute('contribkanban_boards.roulette')->toString(),
      'current' => $route_name === 'contribkanban_boards.roulette',
    ],
    [
      'label' => (string) t('Create a board'),
      'description' => (string) t('Track a project or an issue tag'),
      'icon' => 'create',
      'url' => Url::fromRoute('contribkanban_boards.create_board')->toString(),
      'current' => $route_name === 'contribkanban_boards.create_board',
    ],
  ];
  // Boards and the roulette render their own title.
  $variables['board_page'] = in_array($route_name, [
    'entity.board.canonical',
    'entity.board.canonical_alternative',
    'entity.board.version',
    'entity.board.embed',
    'entity.node_board.canonical',
    'contribkanban_boards.roulette',
  ], TRUE);
  $variables['account_link'] = \Drupal::currentUser()->isAnonymous()
    ? ['label' => (string) t('Log in'), 'url' => Url::fromRoute('user.login')->toString()]
    : ['label' => (string) t('Account'), 'url' => Url::fromRoute('user.page')->toString()];
  $variables['#cache']['contexts'][] = 'route';
  $variables['#cache']['contexts'][] = 'user.roles:anonymous';
}

/**
 * Implements hook_theme_suggestions_HOOK_alter() for page templates.
 */
function contribkanban_theme_suggestions_page_alter(array &$suggestions): void {
  // Embedded boards leave out the site header and footer.
  if (\Drupal::routeMatch()->getRouteName() === 'entity.board.embed') {
    $suggestions[] = 'page__board_embed';
  }
}

/**
 * Implements hook_preprocess_HOOK() for board templates.
 */
function contribkanban_preprocess_board(array &$variables): void {
  $board = $variables['elements']['#board'];
  assert($board instanceof BoardInterface);
  if ($variables['elements']['#view_mode'] === 'full') {
    $config = $variables['elements']['#island'];
    // The board view adds the route cache context.
    if (\Drupal::routeMatch()->getRouteName() === 'entity.board.embed') {
      $variables['shell'] = [
        'title' => (string) $board->label(),
        'embed' => TRUE,
        'config' => $config,
      ];
      return;
    }
    $variables['shell'] = [
      'title' => (string) $board->label(),
      'back_url' => Url::fromRoute('view.board_listing.page')->toString(),
      'source_url' => _contribkanban_board_source_url($board, $config['gitlabProject']),
      'gitlab_url' => $config['gitlabLabel'] !== NULL
        ? 'https://git.drupalcode.org/groups/project/-/work_items?label_name[]=' . rawurlencode($config['gitlabLabel'])
        : '',
      'roulette_url' => _contribkanban_board_roulette_url($board),
      'bookmark' => $variables['elements']['#bookmark'] ?? [],
      'embed_url' => Url::fromRoute('entity.board.embed', [
        'board' => $board->get('machine_name')->value ?? $board->id(),
      ])->toString(),
      'config' => $config,
    ];
    return;
  }
  $bundles = \Drupal::service('entity_type.bundle.info')->getBundleInfo('board');
  $gitlab = $board->bundle() === 'drupalorg_project' && (bool) $board->get('gitlab_work_items')->value;
  $variables['card'] = [
    'title' => (string) $board->label(),
    'url' => $board->toUrl()->toString(),
    'type' => (string) $bundles[$board->bundle()]['label'],
    'source' => $gitlab ? 'gitlab' : 'drupalorg',
  ];
}

/**
 * Implements hook_preprocess_HOOK() for issue collection templates.
 */
function contribkanban_preprocess_node_board(array &$variables): void {
  $collection = $variables['elements']['#node_board'];
  assert($collection instanceof NodeBoard);
  $variables['shell'] = [
    'title' => (string) $collection->label(),
    'edit_url' => $variables['elements']['#edit_url'] ?? '',
    'config' => $variables['elements']['#island'],
  ];
}

/**
 * Implements hook_preprocess_HOOK() for the issue roulette.
 */
function contribkanban_preprocess_issue_roulette(array &$variables): void {
  // A project's roulette links back to its board.
  $board = $variables['board'];
  $variables['roulette'] = [
    'title' => (string) t('Issue roulette'),
    'back_url' => $board instanceof BoardInterface
      ? $board->toUrl()->toString()
      : Url::fromRoute('view.board_listing.page')->toString(),
    'back_label' => $board instanceof BoardInterface ? (string) $board->label() : (string) t('All boards'),
    'config' => $variables['config'],
  ];
}

/**
 * Gets the issue roulette URL for a tag or project board.
 *
 * @param \Drupal\contribkanban_boards\Entity\BoardInterface $board
 *   The board.
 *
 * @return string
 *   The URL, or an empty string for boards the roulette can't roll for.
 */
function _contribkanban_board_roulette_url(BoardInterface $board): string {
  $query = match ($board->bundle()) {
    'drupalorg_sprint' => ['tag' => (string) $board->label()],
    'drupalorg_project' => ['project' => (string) $board->get('machine_name')->value],
    default => NULL,
  };
  return $query !== NULL
    ? Url::fromRoute('contribkanban_boards.roulette', [], ['query' => $query])->toString()
    : '';
}

/**
 * Gets the page that lists a board's issues on drupal.org or GitLab.
 *
 * @param \Drupal\contribkanban_boards\Entity\BoardInterface $board
 *   The board.
 * @param string|null $gitlab_project
 *   The GitLab project path, when the board reads GitLab.
 *
 * @return string
 *   The URL, or an empty string for a project board without a project or a
 *   GitLab label's board.
 */
function _contribkanban_board_source_url(BoardInterface $board, ?string $gitlab_project): string {
  if ($gitlab_project !== NULL) {
    return "https://git.drupalcode.org/$gitlab_project/-/work_items";
  }
  $project_nid = $board->get('project_nid')->value;
  // A GitLab label drupal.org has no tag for has no drupal.org issues.
  if ($board->bundle() === 'drupalorg_sprint' && $board->get('tag')->isEmpty()) {
    return '';
  }
  return match ($board->bundle()) {
    'drupalorg_sprint' => 'https://www.drupal.org/project/issues/search?issue_tags=' . rawurlencode((string) $board->label()),
    'drupalorg_core' => 'https://www.drupal.org/project/issues/drupal',
    default => is_string($project_nid) && $project_nid !== '' ? "https://www.drupal.org/node/$project_nid" : '',
  };
}

/**
 * Implements hook_preprocess_HOOK() for the board listing view.
 */
function contribkanban_preprocess_views_view__board_listing(array &$variables): void {
  $query = \Drupal::request()->query;
  $current_type = (string) $query->get('type', '');
  $search = (string) $query->get('search', '');
  $types = [
    '' => t('All'),
    'drupalorg_project' => t('Projects'),
    'drupalorg_sprint' => t('Tags'),
    'drupalorg_core' => t('Core components'),
  ];
  $variables['type_links'] = [];
  foreach ($types as $type => $label) {
    $variables['type_links'][] = [
      'label' => (string) $label,
      'url' => Url::fromRoute('<current>', [], [
        'query' => array_filter(['type' => $type, 'search' => $search]),
      ])->toString(),
      'current' => $type === $current_type,
    ];
  }
  $bundles = \Drupal::service('entity_type.bundle.info')->getBundleInfo('board');
  $variables['popular'] = [];
  $tags = [PopularBoards::CACHE_TAG];
  foreach (\Drupal::service('contribkanban_boards.popular_boards')->load() as $board) {
    $variables['popular'][] = [
      'label' => (string) $board->label(),
      'type' => (string) $bundles[$board->bundle()]['label'],
      'url' => $board->toUrl()->toString(),
    ];
    $tags = Cache::mergeTags($tags, $board->getCacheTags());
  }
  $variables['#cache']['tags'] = Cache::mergeTags($variables['#cache']['tags'] ?? [], $tags);
  $variables['#cache']['contexts'][] = 'url.query_args:type';
  $variables['#cache']['contexts'][] = 'url.query_args:search';
}

/**
 * Implements hook_form_BASE_FORM_ID_alter() for issue collection forms.
 */
function contribkanban_form_node_board_form_alter(array &$form, FormStateInterface $form_state): void {
  // The board island lists the collection's issues under its issue IDs field.
  $form['#attached']['library'][] = 'core/components.contribkanban--board-shell';
}

/**
 * Implements hook_form_FORM_ID_alter() for views_exposed_form.
 */
function contribkanban_form_views_exposed_form_alter(array &$form, FormStateInterface $form_state): void {
  if (($form['#id'] ?? '') !== 'views-exposed-form-board-listing-page') {
    return;
  }
  $form['#attributes']['role'] = 'search';
  $form['#attributes']['class'][] = 'board-search';
  $form['search']['#title_display'] = 'invisible';
  $form['search']['#type'] = 'search';
  $form['search']['#attributes']['placeholder'] = t('Search projects, tags, and components');
  // The type links below the search field set the type.
  $form['type']['#type'] = 'hidden';
}
