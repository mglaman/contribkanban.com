{# Embedded on another site, the board is only its columns. #}
<div class="board-shell{{ embed ? ' board-shell--embed' }}">
  {% if embed %}
  <h1 class="visually-hidden">{{ title }}</h1>
  {% else %}
  <div class="board-shell__header">
    <div class="board-shell__heading">
      {% if back_url %}
        <a class="board-shell__back" href="{{ back_url }}"><span aria-hidden="true">←</span> {{ 'All boards'|t }}</a>
      {% endif %}
      <h1>{{ title }}</h1>
      {% if source_url %}
        <p class="board-shell__source">
          {% if config.source == 'gitlab' %}
            {{ 'Work items from <a href=":url">git.drupalcode.org</a>'|t({':url': source_url}) }}
          {% elseif gitlab_url %}
            {{ 'Issues from <a href=":url">drupal.org</a> and <a href=":gitlab">git.drupalcode.org</a>'|t({':url': source_url, ':gitlab': gitlab_url}) }}
          {% else %}
            {{ 'Issues from <a href=":url">drupal.org</a>'|t({':url': source_url}) }}
          {% endif %}
        </p>
      {% endif %}
      {# Tag boards from sprints put work in flight first, which surprises people. #}
      {% if (config.lists|first).tone == 'needs-review' %}
        <details class="board-shell__help">
          <summary>{{ 'Why does Needs review come first?'|t }}</summary>
          <p>{{ 'This board starts with issues that already have work in them. Reviewing and finishing those moves more issues forward than starting new ones, so start with Needs review, then Needs work, then Active.'|t }}</p>
        </details>
      {% endif %}
      {% if roulette_url %}
        <p>
          <a class="board-shell__roulette" href="{{ roulette_url }}">
            {# The same die as the roulette's Roll button. #}
            <svg width="18" height="18" viewBox="0 0 22 22" fill="none" aria-hidden="true">
              <rect x="2.5" y="2.5" width="17" height="17" rx="4" stroke="currentColor" stroke-width="1.8"/>
              <circle cx="7.5" cy="7.5" r="1.4" fill="currentColor"/>
              <circle cx="11" cy="11" r="1.4" fill="currentColor"/>
              <circle cx="14.5" cy="14.5" r="1.4" fill="currentColor"/>
            </svg>
            {{ 'Roll for an issue'|t }}
          </a>
        </p>
      {% endif %}
      {% if edit_url %}
        <p><a class="board-shell__edit" href="{{ edit_url }}">{{ 'Edit'|t }}</a></p>
      {% endif %}
    </div>
    <div class="board-shell__filters" data-board-filters></div>
  </div>
  {% endif %}
  <noscript>
    <p class="board-shell__noscript">{{ 'The board loads issues with JavaScript. Turn it on to see them.'|t }}</p>
  </noscript>
  {# The island replaces these columns. #}
  <div class="board-shell__columns" data-board="{{ config|json_encode }}">
    {% for list in config.lists %}
      <section class="board-column">
        <h2 class="board-column__header board-column__header--{{ list.tone }}">{{ list.title }}</h2>
        <p class="board-column__status">{{ 'Loading issues…'|t }}</p>
      </section>
    {% endfor %}
  </div>
</div>
