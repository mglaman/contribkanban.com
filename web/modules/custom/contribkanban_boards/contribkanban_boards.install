<?php

/**
 * @file
 * Install, update and uninstall functions for contribkanban_boards.
 */

use Drupal\contribkanban_boards\Entity\Board;
use Drupal\contribkanban_boards\Entity\BoardInterface;
use Drupal\search_api\IndexInterface;

/**
 * Add the GitLab work items field to boards.
 */
function contribkanban_boards_update_10001(): void {
  \Drupal::entityDefinitionUpdateManager()->installFieldStorageDefinition(
    'gitlab_work_items',
    'board',
    'contribkanban_boards',
    Board::gitlabWorkItemsFieldDefinition()
  );
}

/**
 * Prune board configuration and make machine names unique.
 *
 * Removes the parent issue, category, and priority settings, deletes custom
 * and stale boards and orphaned lists, and renames duplicate machine names.
 */
function contribkanban_boards_update_10002(): string {
  // Drop the index fields first, or Search API fails to rebuild its Views
  // data for properties that no longer exist.
  $index = \Drupal::moduleHandler()->moduleExists('search_api')
    ? \Drupal::entityTypeManager()->getStorage('search_api_index')->load('boards')
    : NULL;
  if ($index instanceof IndexInterface) {
    foreach (['category', 'priority'] as $field_id) {
      if ($index->getField($field_id) !== NULL) {
        $index->removeField($field_id);
      }
    }
    $index->save();
  }

  $update_manager = \Drupal::entityDefinitionUpdateManager();
  $fields = [
    'board' => ['parent_issue'],
    'board_list' => ['category', 'parent_issue', 'priority'],
  ];
  foreach ($fields as $entity_type_id => $field_names) {
    foreach ($field_names as $field_name) {
      $definition = $update_manager->getFieldStorageDefinition($field_name, $entity_type_id);
      if ($definition !== NULL) {
        $update_manager->uninstallFieldStorageDefinition($definition);
      }
    }
  }

  $entity_type_manager = \Drupal::entityTypeManager();
  $board_storage = $entity_type_manager->getStorage('board');
  $list_storage = $entity_type_manager->getStorage('board_list');

  // Custom boards were built in the admin UI and are all abandoned. The
  // experience_builder project was renamed to canvas, which has its own board.
  $stale = $board_storage->loadByProperties(['type' => 'drupalorg_custom'])
    + $board_storage->loadByProperties(['machine_name' => 'experience_builder']);
  $board_storage->delete($stale);

  // Lists whose board no longer exists.
  $database = \Drupal::database();
  $query = $database->select('board_list', 'l');
  $query->leftJoin('board', 'b', '[b].[board_id] = [l].[board_id]');
  $orphan_ids = $query->fields('l', ['board_list_id'])
    ->isNull('b.board_id')
    ->execute()
    ->fetchCol();
  $list_storage->delete($list_storage->loadMultiple($orphan_ids));

  // Boards are routed by machine name, so a duplicate is unreachable. Keep
  // the oldest board's name. Tag boards take the -tag suffix that new tag
  // boards get, and anything else gets its board ID.
  $duplicates = $database->select('board', 'b')
    ->fields('b', ['machine_name'])
    ->groupBy('b.machine_name')
    ->having('COUNT(*) > 1')
    ->execute()
    ->fetchCol();
  $renamed = [];
  foreach ($duplicates as $machine_name) {
    $ids = $board_storage->getQuery()
      ->accessCheck(FALSE)
      ->condition('machine_name', $machine_name)
      ->sort('board_id')
      ->execute();
    array_shift($ids);
    foreach ($board_storage->loadMultiple($ids) as $board) {
      assert($board instanceof BoardInterface);
      $suffix = $board->bundle() === 'drupalorg_sprint' ? 'tag' : $board->id();
      $board->set('machine_name', "$machine_name-$suffix");
      $board->save();
      $renamed[] = "$machine_name to " . $board->get('machine_name')->value;
    }
  }

  return sprintf(
    'Deleted %d boards and %d orphaned lists. Renamed %s.',
    count($stale),
    count($orphan_ids),
    $renamed ? implode(', ', $renamed) : 'no boards'
  );
}

/**
 * Add the popular search weight field to boards.
 */
function contribkanban_boards_update_10003(): void {
  \Drupal::entityDefinitionUpdateManager()->installFieldStorageDefinition(
    'popular_weight',
    'board',
    'contribkanban_boards',
    Board::popularWeightFieldDefinition()
  );
}
