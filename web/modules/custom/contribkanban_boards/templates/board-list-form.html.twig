<div class="flex flex-direction-column">
  <div class="main">
    {{ form|without('statuses', 'actions', 'component', 'project_nid') }}
  </div>
  <div class="options">
    <div class="flex flex-direction-row">
      <div class="flex-column">
        {{ form.statuses }}
      </div>
    </div>
  </div>
  <div class="options">
    <div class="flex flex-direction-column">
      <div class="flex-column">
        {{ form.component }}
        {{ form.project_nid }}
      </div>
    </div>
    <div class="actions">
      {{ form.actions }}
    </div>
  </div>
</div>
