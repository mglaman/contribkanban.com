<?php

/**
 * @file
 * Hooks for contribkanban_boards.
 */

use Drupal\contribkanban_boards\BoardIslandConfig;
use Drupal\contribkanban_boards\Entity\BoardInterface;
use Drupal\contribkanban_boards\Entity\NodeBoard;
use Drupal\Core\Cache\Cache;
use Drupal\Core\Cache\CacheableMetadata;
use Drupal\Core\Entity\Display\EntityViewDisplayInterface;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Field\EntityReferenceFieldItemListInterface;
use Drupal\Core\Link;
use Drupal\Core\Site\Settings;
use Drupal\Core\Url;

/**
 * Implements hook_theme().
 */
function contribkanban_boards_theme($existing, $type, $theme, $path) {
  return [
    'board' => [
      'render element' => 'elements',
    ],
    'board_list' => [
      'render element' => 'elements',
    ],
    'node_board' => [
      'render element' => 'elements',
    ],
    'field__board__lists' => [
      'base hook' => 'field',
    ],
    'board_form' => [
      'render element' => 'form',
    ],
    'board_list_form' => [
      'render element' => 'form',
    ],
    'issue_roulette' => [
      'variables' => ['config' => []],
    ],
  ];
}

/**
 * Implements hook_theme_suggestions_HOOK().
 */
function contribkanban_boards_theme_suggestions_board(array $variables): array {
  $board = $variables['elements']['#board'];
  assert($board instanceof BoardInterface);
  $view_mode = strtr($variables['elements']['#view_mode'], '.', '_');
  return [
    'board__' . $view_mode,
    'board__' . $board->bundle(),
    'board__' . $board->bundle() . '__' . $view_mode,
  ];
}

/**
 * Implements hook_ENTITY_TYPE_view().
 *
 * Adds the configuration the board island reads, for the theme to render.
 */
function contribkanban_boards_node_board_view(array &$build, EntityInterface $entity, EntityViewDisplayInterface $display, $view_mode): void {
  if ($view_mode !== 'full') {
    return;
  }
  assert($entity instanceof NodeBoard);
  $build['#island'] = BoardIslandConfig::collection($entity, _contribkanban_boards_gitlab_project_nids());
  $build['#cache']['tags'][] = 'project_list';
  $edit = $entity->toUrl('edit-form');
  $access = $edit->access(NULL, TRUE);
  $build['#edit_url'] = $access->isAllowed() ? $edit->toString() : NULL;
  CacheableMetadata::createFromRenderArray($build)
    ->addCacheableDependency($access)
    ->applyTo($build);
}

/**
 * Implements hook_ENTITY_TYPE_view() for user entities.
 *
 * Lists the issue collections on the user's own account page.
 */
function contribkanban_boards_user_view(array &$build, EntityInterface $entity, EntityViewDisplayInterface $display, $view_mode): void {
  $build['#cache']['contexts'][] = 'user';
  if ($view_mode !== 'full' || (int) $entity->id() !== (int) \Drupal::currentUser()->id()) {
    return;
  }
  $storage = \Drupal::entityTypeManager()->getStorage('node_board');
  $ids = $storage->getQuery()
    ->accessCheck(TRUE)
    ->condition('uid', $entity->id())
    ->sort('title')
    ->execute();
  $items = [];
  foreach ($storage->loadMultiple($ids) as $collection) {
    $items[] = [
      'view' => $collection->toLink()->toRenderable(),
      'edit' => $collection->toLink(t('Edit'), 'edit-form', [
        'attributes' => ['class' => ['issue-collections__edit']],
      ])->toRenderable(),
    ];
  }
  $build['issue_collections'] = [
    '#type' => 'container',
    '#attributes' => ['class' => ['issue-collections']],
    '#weight' => -10,
    '#cache' => ['tags' => ['node_board_list']],
    'heading' => [
      '#type' => 'html_tag',
      '#tag' => 'h2',
      '#value' => t('Your issue collections'),
    ],
    'list' => [
      '#theme' => 'item_list',
      '#items' => $items,
      '#empty' => t('Collect issues from any project on one board.'),
      '#attributes' => ['class' => ['issue-collections__list']],
    ],
    'actions' => [
      '#type' => 'container',
      '#attributes' => ['class' => ['issue-collections__actions']],
      'add' => Url::fromRoute('entity.node_board.add_form')->access()
        ? Link::createFromRoute(t('New issue collection'), 'entity.node_board.add_form', [], [
          'attributes' => ['class' => ['button']],
        ])->toRenderable()
        : [],
      'logout' => Link::createFromRoute(t('Log out'), 'user.logout')->toRenderable(),
    ],
  ];
}

/**
 * Implements hook_ENTITY_TYPE_view().
 *
 * Adds the configuration the board island reads, for the theme to render.
 */
function contribkanban_boards_board_view(array &$build, EntityInterface $entity, EntityViewDisplayInterface $display, $view_mode): void {
  if ($view_mode !== 'full') {
    return;
  }
  assert($entity instanceof BoardInterface);
  $version = \Drupal::routeMatch()->getParameter('version');
  $moved_projects = [];
  if ($entity->bundle() === 'drupalorg_sprint') {
    $moved_projects = _contribkanban_boards_gitlab_project_nids();
    $build['#cache']['tags'][] = 'project_list';
  }
  $build['#island'] = BoardIslandConfig::build($entity, is_string($version) ? $version : '', $moved_projects);
  // The version comes from the route.
  $build['#cache']['contexts'][] = 'route';
  $lists = $entity->get('lists');
  assert($lists instanceof EntityReferenceFieldItemListInterface);
  foreach ($lists->referencedEntities() as $list) {
    $build['#cache']['tags'] = Cache::mergeTags($build['#cache']['tags'] ?? [], $list->getCacheTags());
  }
}

/**
 * Gets the node IDs of projects whose issues moved to GitLab.
 *
 * @return list<int>
 *   The node IDs, from projects flagged by drush ck-gitlab.
 */
function _contribkanban_boards_gitlab_project_nids(): array {
  $entity_type_manager = \Drupal::entityTypeManager();
  if (!$entity_type_manager->hasDefinition('project')) {
    return [];
  }
  $rows = $entity_type_manager->getStorage('project')->getAggregateQuery()
    ->accessCheck(FALSE)
    ->condition('gitlab_issues', 1)
    ->groupBy('nid')
    ->execute();
  return array_values(array_map(static fn (array $row): int => (int) $row['nid'], $rows));
}

/**
 * Implements hook_inline_entity_form_entity_form_alter().
 */
function contribkanban_boards_inline_entity_form_entity_form_alter(&$entity_form, &$form_state) {
  if ($entity_form['#entity_type'] == 'board_list') {
    $entity_form['#theme'] = ['board_list_form'];
    $entity_form['#attached']['library'][] = 'contribkanban_boards/form';
  }
}

/**
 * Implements hook_page_attachments().
 *
 * Adds Fathom analytics where the site sets `fathom_site_id`.
 */
function contribkanban_boards_page_attachments(array &$attachments): void {
  $site_id = Settings::get('fathom_site_id');
  if (!is_string($site_id) || $site_id === '' || \Drupal::service('router.admin_context')->isAdminRoute()) {
    return;
  }
  $attachments['#attached']['html_head'][] = [
    [
      '#tag' => 'script',
      '#attributes' => [
        'src' => 'https://cdn.usefathom.com/script.js',
        'data-site' => $site_id,
        'defer' => TRUE,
      ],
    ],
    'fathom',
  ];
}
