<?php

/**
 * @file
 * Install, update and uninstall functions for contribkanban_api.
 */

declare(strict_types=1);

/**
 * Implements hook_update_last_removed().
 */
function contribkanban_api_update_last_removed(): int {
  return 10001;
}

/**
 * Delete OAuth2 tokens and consumers, so config import can uninstall them.
 *
 * Drupal refuses to uninstall a module while entities of its types exist.
 */
function contribkanban_api_update_10002(array &$sandbox): void {
  $entity_type_manager = \Drupal::entityTypeManager();
  $entity_type_ids = array_values(array_filter(
    ['oauth2_token', 'consumer'],
    static fn (string $entity_type_id): bool => $entity_type_manager->hasDefinition($entity_type_id),
  ));
  foreach ($entity_type_ids as $entity_type_id) {
    $storage = $entity_type_manager->getStorage($entity_type_id);
    $ids = $storage->getQuery()->accessCheck(FALSE)->range(0, 50)->execute();
    if ($ids !== []) {
      $storage->delete($storage->loadMultiple($ids));
      $sandbox['#finished'] = 0;
      return;
    }
  }
  $sandbox['#finished'] = 1;
}
