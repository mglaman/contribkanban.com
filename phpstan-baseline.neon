parameters:
	ignoreErrors:
		-
			message: '#^Storing entity storage as a class property is not recommended\. Call Drupal\\Core\\Entity\\EntityTypeManagerInterface\:\:getStorage\(\) at the call\-site instead\.$#'
			identifier: drupal.entityStoragePropertyAssignment
			count: 1
			path: web/modules/custom/contribkanban_api/src/Controller/AddBoard.php

		-
			message: '#^Storing entity storage as a class property is not recommended\. Call Drupal\\Core\\Entity\\EntityTypeManagerInterface\:\:getStorage\(\) at the call\-site instead\.$#'
			identifier: drupal.entityStoragePropertyAssignment
			count: 1
			path: web/modules/custom/contribkanban_api/src/Controller/AddTag.php

		-
			message: '#^Negated boolean expression is always false\.$#'
			identifier: booleanNot.alwaysFalse
			count: 2
			path: web/modules/custom/contribkanban_boards/contribkanban_boards.post_update.php

		-
			message: '#^Result of \|\| is always false\.$#'
			identifier: booleanOr.alwaysFalse
			count: 1
			path: web/modules/custom/contribkanban_boards/contribkanban_boards.post_update.php

		-
			message: '#^Access to an undefined property Drupal\\Core\\Field\\FieldItemInterface\:\:\$entity\.$#'
			identifier: property.notFound
			count: 2
			path: web/modules/custom/contribkanban_boards/src/Entity/Board.php

		-
			message: '#^Access to an undefined property Drupal\\Core\\Field\\FieldItemInterface\:\:\$value\.$#'
			identifier: property.notFound
			count: 5
			path: web/modules/custom/contribkanban_boards/src/Entity/BoardList.php

		-
			message: '#^\\Drupal calls should be avoided in classes, use dependency injection instead$#'
			identifier: globalDrupalDependencyInjection.useDependencyInjection
			count: 5
			path: web/modules/custom/contribkanban_boards/src/EventSubscriber/MissingBoardExceptionHtmlSubscriber.php

		-
			message: '#^Instanceof between Drupal\\Core\\Entity\\EntityInterface and Drupal\\Core\\Entity\\EntityInterface will always evaluate to true\.$#'
			identifier: instanceof.alwaysTrue
			count: 1
			path: web/modules/custom/contribkanban_boards/src/ParamConverter/EntityUuidConverter.php

		-
			message: '#^Access to an undefined property Drupal\\Core\\Field\\FieldItemInterface\:\:\$value\.$#'
			identifier: property.notFound
			count: 1
			path: web/modules/custom/contribkanban_boards/src/Plugin/Field/FieldWidget/StringOptionsWidget.php

		-
			message: '#^Storing entity storage as a class property is not recommended\. Call Drupal\\Core\\Entity\\EntityTypeManagerInterface\:\:getStorage\(\) at the call\-site instead\.$#'
			identifier: drupal.entityStoragePropertyAssignment
			count: 1
			path: web/modules/custom/contribkanban_projects/src/Scraper.php

		-
			message: '#^Call to function assert\(\) with true will always evaluate to true\.$#'
			identifier: function.alreadyNarrowedType
			count: 2
			path: web/modules/custom/contribkanban_users/contribkanban_users.post_update.php

		-
			message: '#^Instanceof between Drupal\\user\\Entity\\User and Drupal\\user\\UserInterface will always evaluate to true\.$#'
			identifier: instanceof.alwaysTrue
			count: 1
			path: web/modules/custom/contribkanban_users/contribkanban_users.post_update.php

		-
			message: '#^Instanceof between Drupal\\user\\UserStorage and Drupal\\user\\UserStorageInterface will always evaluate to true\.$#'
			identifier: instanceof.alwaysTrue
			count: 1
			path: web/modules/custom/contribkanban_users/contribkanban_users.post_update.php

		-
			message: '#^Call to function assert\(\) with true will always evaluate to true\.$#'
			identifier: function.alreadyNarrowedType
			count: 1
			path: web/modules/custom/contribkanban_users/src/GravatarFieldItemList.php

		-
			message: '#^Instanceof between Drupal\\Core\\Field\\FieldItemInterface and Drupal\\Core\\Field\\FieldItemInterface will always evaluate to true\.$#'
			identifier: instanceof.alwaysTrue
			count: 1
			path: web/modules/custom/contribkanban_users/src/GravatarFieldItemList.php

