FROM uselagoon/php-8.4-cli-drupal

RUN composer self-update --2

COPY composer.json composer.lock /app/
COPY scripts /app/scripts
RUN composer install --prefer-dist --no-dev
COPY . /app

ENV WEBROOT=web
# Drush Launcher only detects Drush 8-11, so it falls back for Drush 12+.
# Point the fallback at the project's Drush instead of the image's Drush 8.
ENV DRUSH_LAUNCHER_FALLBACK=/app/bin/drush
