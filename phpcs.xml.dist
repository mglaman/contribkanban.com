<?xml version="1.0" encoding="UTF-8"?>
<ruleset name="contribkanban">
  <description>Drupal coding standards for custom code.</description>

  <file>web/modules/custom</file>
  <file>web/profiles/custom</file>

  <exclude-pattern>*/vendor/*</exclude-pattern>

  <arg name="extensions" value="php,module,inc,install,test,profile,theme,info,yml"/>
  <arg name="colors"/>
  <arg value="sp"/>

  <rule ref="Drupal">
    <!-- Class names say what a class is; a required docblock only repeats it. -->
    <exclude name="Drupal.Commenting.ClassComment"/>
  </rule>
  <rule ref="DrupalPractice"/>
</ruleset>
